# ── POS 도메인 ───────────────────────────────────────
POS_PORTAL_URL=https://topint.co.kr
POS_BASE_URL=https://asp.topint.co.kr
POS_LANDING_URL=https://asp.topint.co.kr/asp_office/asp_main/main.asp

# ── 매장 식별 ────────────────────────────────────────
POS_BRANCH=
POS_STORE_BRANCH_NAME=
POS_HQ_BRANCH=

# ── 브랜드 코드 ──────────────────────────────────────
# combo_brandcode_sch.asp 조회로 확인. 아래 두 개는 역할이 다르다.
# POS_BRANDCODE       : 매장이 속한 브랜드 (기록·식별용)
# POS_REPORT_BRANDCODE: 리포트 요청에 실어 보내는 값
POS_BRANDCODE=
POS_REPORT_BRANDCODE=

# ── POS 계정 (자동 로그인) ────────────────────────────
POS_USER_ID=
POS_USER_PW=

# ── 세션 쿠키 (예비 수단) ─────────────────────────────
POS_SESSION_COOKIE=

# ── 대시보드 계정 (POS 계정과 분리, FR-AUTH-03/04) ────
DASHBOARD_ADMIN_ID=
DASHBOARD_ADMIN_PW=
SESSION_SECRET=
# 세션 쿠키에 Secure 를 붙일지 (NFR-SEC-01). 로컬 http 개발에서는 비워 둔다.
# Vercel 에서는 지정하지 않아도 자동으로 켜진다.
SESSION_COOKIE_SECURE=

# ── 저장소 ──────────────────────────────────────────
DATABASE_URL=sqlite:///./data/sodam.db
STORE_CODE=SODAM_MAGOK
STORE_NAME=

# 배포된 대시보드 주소. `python -m server.shortcut` 이 만드는
# 바로가기 HTML 이 이곳을 가리킨다 (사장님께 파일 하나로 전달).
DASHBOARD_URL=

# ── 수동 수집 버튼 (FN-205 / FR-COL-07) ──────────────
# 화면의 "지금 수집" 버튼이 무엇을 깨울지 결정한다.
#
#  · 내 PC·자체 서버  : 아래를 비워 두면 이 프로세스가 직접 수집한다 (POS_USER_ID 필요)
#  · Vercel 배포      : DISPATCH_* 를 채운다. Vercel 함수는 10초에서 끊기고
#                       POS 계정도 올리지 않으므로 Actions에게 부탁만 한다.
#
# 이름에 GITHUB_ 접두사를 쓰지 않는다 — Actions가 GITHUB_* 를 예약해 쓰고
# GITHUB_REF_NAME 같은 값은 워크플로 안에서 자동으로 덮어써진다.
# DISPATCH_TOKEN 은 `actions:write` 권한만 있는 PAT.
# ⚠ POS 계정이 아니다. POS 계정은 Vercel에 올리지 않는다.
DISPATCH_REPO=
DISPATCH_WORKFLOW=collect.yml
DISPATCH_REF=main
DISPATCH_TOKEN=

# 수동 수집 최소 간격(초). POS 서버 배려 규칙 — 기본 10분.
MANUAL_COLLECT_MIN_INTERVAL_SEC=600

# ── 수집 스케줄 (FN-601 / FN-605) ────────────────────
COLLECT_HOUR=4
COLLECT_TZ=Asia/Seoul
REQUEST_DELAY_SEC=1.0
BACKFILL_MONTHS=12

# ── 스케줄러 (FN-601) ────────────────────────────────
SCHEDULER_ENABLED=false

# ── 실패 알림 SMTP (선택) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── 실패 알림 (FN-606 / NFR-OPS-03) ──────────────────
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
