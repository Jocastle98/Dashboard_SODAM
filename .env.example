# ─────────────────────────────────────────────────────
#  실제 값은 .env 에만 넣습니다. 이 파일에는 절대 채우지 마세요.
#  (.env 는 .gitignore 대상, .env.example 은 커밋됩니다)
#  주석의 값들은 2026-08-16 POS 실측 결과입니다 — docs/03_POS_분석결과.md
# ─────────────────────────────────────────────────────

# ── POS 도메인 ───────────────────────────────────────
# 로그인은 포털, 리포트는 asp 서브도메인. 수집기는 두 곳을 오간다.
POS_PORTAL_URL=https://topint.co.kr
POS_BASE_URL=https://asp.topint.co.kr
# 로그인 성공 시 서버가 알려주는 진입 화면 (여기 들러야 리포트 세션이 붙는다)
POS_LANDING_URL=https://asp.topint.co.kr/asp_office/asp_main/main.asp

# ── 매장 식별 ────────────────────────────────────────
# combo_branchSel_sch.asp 를 조회하면 code / name / cd_hdadminbranch 를 준다.
POS_BRANCH=
POS_STORE_BRANCH_NAME=
POS_HQ_BRANCH=

# ── 브랜드 코드 ──────────────────────────────────────
# combo_brandcode_sch.asp 조회로 확인. 아래 두 개는 역할이 다르다.
# POS_BRANDCODE       : 매장이 속한 브랜드 (기록·식별용)
# POS_REPORT_BRANDCODE: 리포트 요청에 실어 보내는 값
POS_BRANDCODE=
# ⚠ 반드시 비워 둔다. 값을 넣으면 timeAnal·menuAnal 이
#    "해당되는 기간에 정보가 없습니다"를 반환한다 (실측 확인).
POS_REPORT_BRANDCODE=

# ── POS 계정 (자동 로그인) ────────────────────────────
# 평소 수집은 이 두 값만으로 동작한다. 쿠키를 만질 일이 없다.
POS_USER_ID=
POS_USER_PW=

# ── 세션 쿠키 (예비 수단) ─────────────────────────────
# 자동 로그인이 막혔을 때만 쓴다. 평소에는 POS_USER_ID/PW 로 매번 로그인한다.
# ⚠ 인증하는 것은 ASPSESSIONID 가 아니라 신원 쿠키(comID/custCode/comNo/memID 등)다.
#    ASPSESSIONID 하나만 넣으면 매장이 식별되지 않아 리포트가 비어서 온다.
#    브라우저 개발자도구 Network 탭의 `Cookie:` 헤더 전체를 넣을 것.
POS_SESSION_COOKIE=

# ── 대시보드 계정 (POS 계정과 분리, FR-AUTH-03/04) ────
# 저장은 bcrypt 해시로 한다 (STEP 4).
DASHBOARD_ADMIN_ID=
DASHBOARD_ADMIN_PW=
SESSION_SECRET=

# ── 저장소 ──────────────────────────────────────────
DATABASE_URL=sqlite:///./data/sodam.db
STORE_CODE=SODAM_MAGOK
STORE_NAME=

# ── 수집 스케줄 (FN-601 / FN-605) ────────────────────
COLLECT_HOUR=4
COLLECT_TZ=Asia/Seoul
REQUEST_DELAY_SEC=1.0
# 초기 적재 범위 — 마곡점은 소급 2년 이상 확인됨
BACKFILL_MONTHS=12

# ── 스케줄러 (FN-601) ────────────────────────────────
# true 면 웹 서버 프로세스 안에서 매일 COLLECT_HOUR시에 수집한다.
# 워커를 2개 이상 띄울 계획이면 false로 두고
# `python -m collector.scheduler`를 별도 프로세스로 돌릴 것 (중복 수집 방지).
SCHEDULER_ENABLED=false

# ── 실패 알림 SMTP (선택) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── 실패 알림 (FN-606 / NFR-OPS-03) ──────────────────
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
