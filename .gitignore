# 비밀정보 — 절대 커밋 금지
.env
# .env 파생 파일 전부 (.env.neon 등) — 실제 연결 문자열·비밀번호가 들어간다.
# 예시 파일만 커밋한다.
.env.*
!.env.example
*.pem
*.key

# 수집 원본 / 실매출 데이터
data/
pos_raw/
*.db
*.sqlite3
*.xls
*.xlsx
*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# 단일 HTML 내보내기 산출물 (실매출 포함)
dist/
.vercel

# ⚠ 아래 예외는 반드시 파일 맨 끝에 있어야 한다.
# gitignore 는 나중 규칙이 이기므로, 위쪽에 두면 `.env*` 류 패턴에 덮인다.
# (Vercel CLI 가 `vercel link` 때 `.env*` 를 자동으로 덧붙인다)
!.env.example
